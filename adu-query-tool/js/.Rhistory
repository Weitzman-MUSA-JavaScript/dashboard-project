#| message: false
library(tidyverse)
library(tidycensus)
library(sf)
library(caret)
library(spdep)
library(nngeo)
options(scipen = 999)
#| label: helpers
check_na <- function(formula, df) {
vars <- all.vars(formula)
bad <- vars[sapply(vars, function(v) any(is.na(df[[v]])))]
if (length(bad) > 0) {
stop("These variables have NAs: ", paste(bad, collapse = ", "),
". Fill them or choose another variable (Rule 1).")
}
}
# 10-fold CV RMSE, same folds every time
cv_rmse <- function(formula, data) {
df <- if (inherits(data, "sf")) st_drop_geometry(data) else data
check_na(formula, df)
set.seed(5080)
fit <- train(formula, data = df, method = "lm",
trControl = trainControl(method = "cv", number = 10))
fit$results$RMSE
}
# Each house's prediction from the fold where it was held out
cv_pred <- function(formula, data) {
df <- if (inherits(data, "sf")) st_drop_geometry(data) else data
check_na(formula, df)
set.seed(5080)
fit <- train(formula, data = df, method = "lm",
trControl = trainControl(method = "cv", number = 10,
savePredictions = "final"))
fit$pred %>% arrange(rowIndex) %>% pull(pred)
}
# Chicago Data Portal (Socrata) -> sf. `where` is a SoQL filter.
socrata_get <- function(dataset, where, select = NULL, limit = 200000) {
where <- str_squish(where)
q <- paste0("$where=", URLencode(where, reserved = TRUE), "&$limit=", limit)
if (!is.null(select)) q <- paste0(q, "&$select=", URLencode(str_squish(select), reserved = TRUE))
url <- paste0("https://data.cityofchicago.org/resource/", dataset, ".geojson?", q)
tmp <- tempfile(fileext = ".geojson")
resp <- tryCatch(download.file(url, tmp, quiet = TRUE), error = function(e) e)
if (inherits(resp, "error")) stop("Portal request failed. Open this URL in a browser to see why:\n", url)
st_read(tmp, quiet = TRUE)
}
#| label: load
train <- read.csv("~/GitHub/MUSA-5080-portfolio/data/chicago_train.csv")
test <- read.csv("~/GitHub/MUSA-5080-portfolio/data/chicago_test.csv")
all_sales <- bind_rows(
read_csv("~/GitHub/MUSA-5080-portfolio/data/chicago_train.csv", show_col_types = FALSE) %>% mutate(split = "train"),
read_csv("~/GitHub/MUSA-5080-portfolio/data/chicago_test.csv",  show_col_types = FALSE) %>% mutate(split = "test")
) %>%
st_as_sf(coords = c("lon", "lat"), crs = 4326) %>%
st_transform(3435)            # Illinois East State Plane, feet
all_sales %>% st_drop_geometry() %>% count(split)
#| label: part-1
train_new <- train
# sale price < $1
train_sp <- train %>%
filter(sale_price<=1)
# num_fireplace > 4 -> mansion
train_fp <- train %>%
filter(num_fireplaces > 4)
# lot size > 3 acres
train_ls <- train %>%
filter(building_000sf > 3)
# sale price > $ 1 million dollars
train_spm <- train %>%
filter(sale_price>1000000)
# Plot 1: sale price <= $1
ggplot(train, aes(x = building_000sf, y = sale_price)) +
geom_point(alpha = 0.3, color = "grey60") +
geom_point(data = train_sp, color = "red", size = 2) +
scale_y_log10(labels = scales::dollar) +
labs(x = "Living area (sq ft)", y = "Sale price (log)",
title = "Sales of $1 or less") +
theme_minimal()
# Plot 2: fireplaces > 4
ggplot(train, aes(x = num_fireplaces, y = sale_price)) +
geom_point(alpha = 0.3, color = "grey60") +
geom_point(data = train_fp, color = "red", size = 2) +
scale_y_continuous(labels = scales::dollar) +
labs(x = "Number of fireplaces", y = "Sale price",
title = "Homes with more than 4 fireplaces") +
theme_minimal()
# Plot 3: lot size > 3 acres
ggplot(train, aes(x = building_000sf, y = sale_price)) +
geom_point(alpha = 0.3, color = "grey60") +
geom_point(data = train_ls, color = "red", size = 2) +
scale_y_continuous(labels = scales::dollar) +
labs(x = "Living area (sq ft)", y = "Sale price",
title = "Lots larger than 3 acres") +
theme_minimal()
# Plot 4: sale price > $1M
ggplot(train, aes(x = building_000sf, y = sale_price)) +
geom_point(alpha = 0.3, color = "grey60") +
geom_point(data = train_spm, color = "red", size = 2) +
scale_y_continuous(labels = scales::dollar) +
labs(x = "Living area (sq ft)", y = "Sale price",
title = "Sales over $1 million") +
theme_minimal()
View(all_sales)
